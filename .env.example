# ============================================================
# MediaRPC configuration - copy this file to `.env` and fill in.
# Only the "required" blocks are needed to start; everything else has
# sensible defaults (shown commented). Uncomment a line to override.
# ============================================================

# --- Emby (required) ---
# To get TOKEN and EMBY_USER_ID: open the Emby web client, log in, press F12
# for the browser console, and run this snippet:
#   ({
#       userId: ApiClient._serverInfo.UserId,
#       token: ApiClient.accessToken()
#   })
EMBY_SERVER=https://your-emby-server.example.com
TOKEN=your_emby_api_token
EMBY_USER_ID=your_emby_user_id

# --- Discord (required) ---
# Application ID from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_application_id

# --- Image hosting (posters). Zipline preferred; ImgBB fallback. ---
# Zipline (self-hosted). Leave blank to use ImgBB only.
ZIPLINE_URL=https://your-zipline.example.com
ZIPLINE_TOKEN=your_zipline_token
ZIPLINE_EXPIRES=7d
ZIPLINE_FOLDER=MediaRPC
# ImgBB API key (optional fallback if Zipline is not set)
IMGBB_KEY=

# --- Ratings / metadata (optional but recommended) ---
TMDB_KEY=your_tmdb_api_key
OMDB_KEY=your_omdb_api_key
# Preferred order of rating sources - first with a value wins. Tokens:
#   emby (Emby community), tmdb, omdb (IMDb), critic (Emby critic /10).
# Reorder to taste, or drop a token to skip that source.
#RATING_ORDER=emby,tmdb,omdb,critic

# --- Behaviour ---
UPDATE_INTERVAL=15
AUTO_PAUSE_WHEN_CLOSED=true
# Show "browsing" presence (Emby library browse + Netflix browse).
# false = only active playback shows on Discord.
#BROWSING_ENABLED=true
# Verbose per-tick logging (rating chains, timer recalcs). Debug only.
#DEBUG=false

# --- Source toggles (false = that source never shows on Discord) ---
# Native Emby source (Sessions API + WebSocket). Off also skips the WS thread.
#EMBY_ENABLED=true

# --- Browser bridge (Netflix + Disney+ + TV 2 Play) ---
# Receives playback state from the browser extension.
BRIDGE_ENABLED=true
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5678
# Seconds before a stale bridge session is cleared (~1 hour)
BRIDGE_ACTIVITY_TIMEOUT=3700
# Per-service switches (require BRIDGE_ENABLED). Turn off one service without
# disabling the whole bridge - e.g. NETFLIX_ENABLED=false hides only Netflix.
#NETFLIX_ENABLED=true
#DISNEY_ENABLED=true
#TV2_ENABLED=true

# --- Plezy source (optional, local playback via mpv IPC) ---
# Reads live playback from Plezy's mpv IPC pipe. In Plezy's mpv config add:
#   input-ipc-server=\\.\pipe\plezympv
# Plezy can stream from a Plex or an Emby backend; toggle each independently.
# (legacy PLEX_ENABLED / PLEX_POLL_INTERVAL / PLEX_MPV_PIPE still work as fallbacks)
#PLEZY_ENABLED=true
#PLEZY_PLEX_ENABLED=true
#PLEZY_EMBY_ENABLED=true
#PLEZY_POLL_INTERVAL=3
#PLEZY_MPV_PIPE=\\.\pipe\plezympv

# --- Profile buttons (optional; Discord shows at most 2) ---
LETTERBOXD_URL=https://letterboxd.com/yourname/
SERIALIZD_URL=https://www.serializd.com/user/yourname/profile
#TRAKT_URL=https://trakt.tv/users/yourname
# Choose which buttons appear. Built-in kinds: letterboxd, serializd, trakt,
# imdb, tmdb (imdb/tmdb deep-link the item you're watching). Custom static
# button: "Label|https://url". Default is the two profile links.
# Examples:  RPC_BUTTONS=imdb,letterboxd   |   RPC_BUTTONS=My Blog|https://x.com,tmdb
#RPC_BUTTONS=letterboxd,serializd

# --- Advanced tuning (defaults shown; rarely needed) ---
#RPC_HEARTBEAT=15            # secs between forced presence refreshes when idle
#PAUSED_SESSION_HOLD=8       # secs to hold a paused Emby session if it vanishes
#CLEAR_SETTLE=0.5            # secs to wait after clearing presence (raise if pauses flicker)
#RECONCILE_TIMEOUT=4         # secs cap on the in-loop Emby session re-check
#POSTER_NULL_TTL=300         # secs to cache a failed poster lookup
#CACHE_MAX_SIZE=300          # max entries per in-memory cache
#IMG_CACHE_SAVE_INTERVAL=15  # min secs between image-cache disk writes
